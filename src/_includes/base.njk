      <a href="/hakkimizda/"{% if "/hakkimizda/" in page.url %} class="active"{% endif %}>Hakkımızda</a>
      <a href="/subeler/"{% if "/subeler/" in page.url %} class="active"{% endif %}>Şubeler</a>
