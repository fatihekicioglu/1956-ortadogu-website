      <a href="/iletisim/"{% if "/iletisim/" in page.url %} class="active"{% endif %}>İletişim</a>
    </nav>
    <a class="btn btn-primary btn-pill header-cta" href="https://docs.google.com/forms/d/e/1FAIpQLScwIlz-WRorQes2rpuac4Enek8_z54BN7Ht3b8NfmVzTAdawQ/viewform" target="_blank" rel="noopener">Kulübe Katıl</a>
