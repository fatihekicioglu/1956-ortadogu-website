---
layout: base.njk
title: Haberler
description: "1956 Orta Doğu HSK'den güncel haberler ve duyurular."
---
<section class="page-hero">
  <div class="container">
    <p class="eyebrow">Gündem</p>
    <h1>Haberler</h1>
  </div>
</section>

<section class="section reveal">
  <div class="container">
    <div class="filter-tabs" id="filterTabs">
      <button class="filter-tab active" data-filter="Tümü">Öne Çıkanlar</button>
      <button class="filter-tab" data-filter="Maç Sonucu">Maç Sonucu</button>
      <button class="filter-tab" data-filter="Kulüp">Kulüp</button>
      <button class="filter-tab" data-filter="Futbol">Futbol</button>
      <button class="filter-tab" data-filter="Satranç">Satranç</button>
      <button class="filter-tab" data-filter="Flag Futbol">Flag Futbol</button>
    </div>
    <div class="card-grid" id="newsGrid">
      {% for haber in collections.haberler %}
      <a class="news-card" href="{{ haber.url }}" data-kategori="{{ haber.data.kategori or "Kulüp" }}">
        {% if haber.data.image %}<img src="{{ haber.data.image }}" alt="{{ haber.data.title }}" class="news-card-img" loading="lazy">{% endif %}
        <span class="news-tag">{{ haber.data.kategori or "Kulüp" }}</span>
        <h3>{{ haber.data.title }}</h3>
        <p class="news-excerpt">{{ haber.data.excerpt }}</p>
        <span class="news-link">{{ haber.date | trDate }} →</span>
      </a>
      {% else %}
      <p class="section-lead">Henüz haber eklenmedi. Yakında burada olacak.</p>
      {% endfor %}
    </div>
  </div>
</section>
